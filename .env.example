# NexAd Environment Variables
# Copy this file to .env and fill in real values before running docker compose.
# All variables listed here are REQUIRED — the app will refuse to start if any are missing.

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://nexad:nexad@postgres:5432/nexad

# ---------------------------------------------------------------------------
# Cache & Pub/Sub (Redis 7)
# Format: redis://<host>:<port>/<db-index>
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Slack HITL Gateway
# Obtain from: https://api.slack.com/apps/<your-app>/incoming-webhooks
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_WITH_YOUR_WEBHOOK_URL

# Signing secret used to verify Slack webhook signatures (found in Basic Information).
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# ---------------------------------------------------------------------------
# Google Ads API
# Obtain from: https://developers.google.com/google-ads/api/docs/first-call/dev-token
# ---------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token_here

# ---------------------------------------------------------------------------
# AWS
# Region for any AWS SDK calls (e.g. Secrets Manager, STS).
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Cryptography
# AES-256 secret key encoded as a 64-character hexadecimal string (32 bytes).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
AES_SECRET_KEY=your_64_char_hex_key_here_replace_with_real_value_00000000000000
